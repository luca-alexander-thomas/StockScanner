<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Bring! Integration">
        <SwitchPreferenceCompat
            app:key="bring_enabled"
            app:title="Bring! Integration aktivieren"
            app:summary="Ermöglicht das Scannen von Artikeln für die Einkaufsliste"
            app:defaultValue="false" />
        <EditTextPreference
            app:key="bring_email"
            app:title="Bring! E-Mail"
            app:dependency="bring_enabled" />
        <EditTextPreference
            app:key="bring_password"
            app:title="Bring! Passwort"
            app:dependency="bring_enabled" />
        <ListPreference
            app:key="bring_list_id"
            app:title="Einkaufsliste auswählen"
            app:summary="Wählen Sie die Liste, die Sie bearbeiten möchten"
            app:dependency="bring_enabled" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Scanner Einstellungen">

        <SwitchPreferenceCompat
            app:key="auto_create_profile"
            app:title="Profil automatisch erstellen"
            app:summary="Erstellt das DataWedge Profil beim App-Start automatisch neu"
            app:defaultValue="true" />

        <Preference
            app:key="recreate_profile"
            app:title="Profil jetzt manuell erstellen"
            app:summary="Triggert die DataWedge Konfiguration sofort" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Daten">
        <Preference
            app:key="clear_history"
            app:title="Historie löschen"
            app:summary="Entfernt alle gespeicherten Scans permanent" />
    </PreferenceCategory>

    <PreferenceCategory app:title="App Info">
        <Preference
            app:title="Version"
            app:summary="1.1.0" />
    </PreferenceCategory>

</PreferenceScreen>